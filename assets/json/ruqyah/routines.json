              "bn": "সহিহ মুসলিম 2262"
            },
            "url": "https://sunnah.com/muslim:2262",
            "kind": "hadith",
            "grade": {
              "en": "Sahih collection",
              "bn": "সহিহ সংকলন"
            }
          }
        },
        {
          "id": "turn",
          "reading_id": null,
          "count": null,
          "instruction": {
            "en": "Turn over to the other side from the one on which you were sleeping. A disturbing dream is not proof that someone has harmed you.",
            "bn": "যে পাশে শুয়েছিলেন তা বদলে অন্য পাশে শুয়ে পড়ুন। দুঃস্বপ্ন কারও অনিষ্ট করার প্রমাণ নয়।"
          },
          "count_source": null
