        "kind": "hadith",
        "grade": {
          "en": "Sahih collection",
          "bn": "সহিহ সংকলন"
        }
      },
      "steps": [
        {
          "id": "ikhlas",
          "reading_id": "ikhlas",
          "count": null,
          "instruction": {
            "en": "Cup your hands together. Recite the three surahs in this cycle.",
            "bn": "দুই হাত একসঙ্গে করুন। এই ধাপে তিনটি সূরা পড়ুন।"
          },
          "count_source": null
        },
        {
          "id": "falaq",
          "reading_id": "falaq",
          "count": null,
          "instruction": null,
          "count_source": null
        },
        {
          "id": "nas",
          "reading_id": "nas",
          "count": null,
          "instruction": null,
          "count_source": null
        },
        {
          "id": "wipe",
          "reading_id": null,
          "count": null,
          "instruction": {
            "en": "Blow gently over your cupped hands and wipe as much of your body as you can, beginning with your head, face and the front of your body. After this, begin the next complete cycle until you have done three.",
            "bn": "একসঙ্গে করা দুই হাতে হালকা ফুঁ দিন। মাথা, মুখমণ্ডল ও শরীরের সামনের দিক থেকে শুরু করে যতটা সম্ভব হাত বুলিয়ে নিন। এরপর শুরু থেকে সম্পূর্ণ আমল আবার করুন, এভাবে তিনবার।"
          },
          "count_source": null
        }
