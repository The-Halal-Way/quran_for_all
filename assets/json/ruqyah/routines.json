    {
      "id": "pain",
      "title": {
        "en": "When the body hurts",
        "bn": "শরীরে ব্যথা হলে"
      },
      "description": {
        "en": "Follow the two reported steps: three, then seven.",
        "bn": "বর্ণিত দুটি ধাপ: প্রথমে তিনবার, তারপর সাতবার।"
      },
      "kind": "reported",
      "cycles": 1,
      "cycle_source": null,
      "steps": [
        {
          "id": "begin",
          "reading_id": "bismillah",
          "count": 3,
          "instruction": {
            "en": "Place your hand where you feel pain and say this three times.",
            "bn": "ব্যথার স্থানে হাত রেখে এটি তিনবার বলুন।"
          },
          "count_source": {
            "label": {
              "en": "Sahih Muslim 2202",
              "bn": "সহিহ মুসলিম 2202"
            },
            "url": "https://sunnah.com/muslim:2202",
            "kind": "hadith",
            "grade": {
              "en": "Sahih collection",
              "bn": "সহিহ সংকলন"
            }
          }
        },
        {
          "id": "refuge",
          "reading_id": "pain_refuge",
          "count": 7,
          "instruction": {
            "en": "Then say this supplication seven times.",
            "bn": "এরপর এই দোয়া সাতবার বলুন।"
          },
          "count_source": {
            "label": {
              "en": "Sahih Muslim 2202",
              "bn": "সহিহ মুসলিম 2202"
            },
            "url": "https://sunnah.com/muslim:2202",
            "kind": "hadith",
            "grade": {
              "en": "Sahih collection",
              "bn": "সহিহ সংকলন"
            }
          }
        }
      ],
      "guide_id": "pain_method",
      "group": "care"
    },
    {
      "id": "bedtime",
      "title": {
        "en": "Bedtime protection",
        "bn": "ঘুমানোর আগে সুরক্ষা"
      },
      "description": {
        "en": "Three surahs, gentle blowing and wiping; three cycles.",
        "bn": "তিন সূরা, হালকা ফুঁ ও শরীরে মোছা; তিনবার।"
      },
