<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/prayer_widget_background" android:padding="16dp">
    <include layout="@layout/prayer_widget_header" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_schedule_label" style="@style/PrayerWidget.Section"
            android:layout_width="0dp" android:layout_weight="1" android:text="@string/prayer_widget_schedule" />
        <TextView android:id="@+id/widget_location" style="@style/PrayerWidget.Text"
            android:maxWidth="150dp" android:textSize="10sp" android:text="Dhaka" />
    </LinearLayout>
    <include layout="@layout/prayer_widget_schedule" />
    <include layout="@layout/prayer_widget_fasting" />
    <TextView android:id="@+id/widget_status" style="@style/PrayerWidget.Text"
        android:layout_width="match_parent" android:gravity="center" android:textSize="9sp"
        android:layout_marginTop="4dp" android:visibility="gone"
        android:text="@string/prayer_widget_open_to_sync" />
</LinearLayout>
