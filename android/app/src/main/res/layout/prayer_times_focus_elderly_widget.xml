<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/prayer_widget_background"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <!-- Header: Mosque badge, Hijri & Gregorian dates, Refresh button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/prayer_widget_mosque_badge">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mosque"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/focus_hijri_date"
                style="@style/PrayerWidgetElderly.Text"
                android:layout_width="match_parent"
                android:textSize="18sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeStepGranularity="0.5sp"
                android:textStyle="bold"
                android:textColor="@color/prayer_widget_gold_light"
                android:text="@string/prayer_widget_hijri_placeholder" />
            <TextView
                android:id="@+id/focus_date"
                style="@style/PrayerWidgetElderly.Text"
                android:layout_width="match_parent"
                android:textSize="12.5sp"
                android:textColor="@color/prayer_widget_text_secondary"
                android:text="Thursday, Nov 26, 2026" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/prayer_widget_refresh">
            <ImageView
                android:id="@+id/widget_refresh_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/prayer_widget_refresh"
                android:importantForAccessibility="no" />
            <ProgressBar
                android:id="@+id/widget_refresh_progress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/prayer_widget_gold"
                android:visibility="gone"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>

    <!-- Dual-Pane Hero: Current Prayer + Live Countdown Timer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/prayer_widget_hero_card"
        android:paddingLeft="11dp"
        android:paddingRight="9dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left: Active / Next Prayer Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:orientation="vertical">
            <TextView
                android:id="@+id/focus_status_label"
                style="@style/PrayerWidgetElderly.Text"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:textStyle="bold"
                android:textColor="@color/prayer_widget_gold"
                android:text="@string/prayer_widget_current_prayer" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/focus_prayer_icon"
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:src="@drawable/ic_sun"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/focus_prayer_name"
                    style="@style/PrayerWidgetElderly.Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="21sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="21sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/prayer_widget_white"
                    android:text="Asr (Hanafi)" />
            </LinearLayout>
            <TextView
                android:id="@+id/focus_prayer_time"
                style="@style/PrayerWidgetElderly.Text"
                android:layout_width="match_parent"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10.5sp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeStepGranularity="0.5sp"
                android:textColor="@color/prayer_widget_text_secondary"
                android:text="3:35 PM – 5:11 PM" />
        </LinearLayout>

        <!-- Right: Emerald Countdown Timer Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.95"
            android:layout_marginStart="8dp"
            android:background="@drawable/prayer_widget_active_pill"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/focus_timer_label"
                style="@style/PrayerWidgetElderly.Text"
                android:layout_width="match_parent"
                android:textSize="10.5sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8.5sp"
                android:autoSizeMaxTextSize="10.5sp"
                android:autoSizeStepGranularity="0.5sp"
                android:letterSpacing="0.04"
                android:textStyle="bold"
                android:textColor="@color/prayer_widget_emerald_light"
                android:gravity="center"
                android:text="@string/prayer_widget_waqt_ends_in" />
            <Chronometer
                android:id="@+id/focus_timer_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="21.5sp"
                android:textStyle="bold"
                android:textColor="@color/prayer_widget_gold_light"
                android:shadowColor="#80101620"
                android:shadowRadius="2"
                android:shadowDy="1" />
            <TextView
                android:id="@+id/focus_timer_fallback"
                style="@style/PrayerWidgetElderly.Value"
                android:layout_marginTop="3dp"
                android:textSize="19sp"
                android:textColor="@color/prayer_widget_gold_light"
                android:visibility="gone"
                android:text="—" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3-Column Strip: Sehri End | Sunrise | Iftar -->
    <LinearLayout
        android:id="@+id/focus_celestial_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/prayer_widget_highlight"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/focus_sehri_label"
                style="@style/PrayerWidgetElderly.Section"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                android:text="@string/prayer_widget_sehri_end" />
            <TextView
                android:id="@+id/focus_sehri_value"
                style="@style/PrayerWidgetElderly.Value"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:textSize="14.5sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11.5sp"
                android:autoSizeMaxTextSize="14.5sp"
                android:autoSizeStepGranularity="0.5sp"
                android:text="—" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="@color/prayer_widget_divider"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/focus_sunrise_label"
                style="@style/PrayerWidgetElderly.Section"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                android:text="@string/prayer_widget_sunrise" />
            <TextView
                android:id="@+id/focus_sunrise_value"
                style="@style/PrayerWidgetElderly.Value"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:textSize="14.5sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11.5sp"
                android:autoSizeMaxTextSize="14.5sp"
                android:autoSizeStepGranularity="0.5sp"
                android:text="—" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="@color/prayer_widget_divider"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/focus_iftar_label"
                style="@style/PrayerWidgetElderly.Section"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                android:text="@string/prayer_widget_iftar" />
            <TextView
                android:id="@+id/focus_iftar_value"
                style="@style/PrayerWidgetElderly.Value"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:textSize="14.5sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11.5sp"
                android:autoSizeMaxTextSize="14.5sp"
                android:autoSizeStepGranularity="0.5sp"
                android:text="—" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        style="@style/PrayerWidgetElderly.Text"
        android:layout_width="match_parent"
        android:gravity="center"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:text="@string/prayer_widget_open_to_sync" />
</LinearLayout>
