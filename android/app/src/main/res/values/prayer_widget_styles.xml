<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="prayer_widget_gold">#F4DA94</color>
    <color name="prayer_widget_white">#FFFFFF</color>
    <color name="prayer_widget_divider">#66FFFFFF</color>
    <style name="PrayerWidget.Text" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/prayer_widget_white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:shadowColor">#80101620</item>
        <item name="android:shadowRadius">2</item>
        <item name="android:shadowDy">1</item>
    </style>
    <style name="PrayerWidget.Title" parent="PrayerWidget.Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PrayerWidget.Hijri" parent="PrayerWidget.Title">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/prayer_widget_gold</item>
        <item name="android:textDirection">ltr</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
    <style name="PrayerWidget.Value" parent="PrayerWidget.Text">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/prayer_widget_gold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="PrayerWidget.RowLabel" parent="PrayerWidget.Text">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PrayerWidget.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/prayer_widget_divider</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="PrayerWidget.Section" parent="PrayerWidget.Text">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textColor">@color/prayer_widget_gold</item>
    </style>
</resources>
